## Halbe Ellipse als Vieleck (Kuppel), Grundlinie bei base.
static func dome(cx: float, base: float, rx: float, ry: float) -> Array:
	var pts: Array = []
	for i in 25:
		var a := PI * i / 24.0
		pts.append(cx + rx * cos(a))
		pts.append(base - ry * sin(a))
	return pts


